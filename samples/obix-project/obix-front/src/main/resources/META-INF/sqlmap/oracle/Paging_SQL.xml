<mapper namespace="COMMON">

    <sql id="pagingPreSQL">
        SELECT * FROM (
            SELECT
                    ROWNUM AS ROW_NUM,
                    CEIL(ROWNUM / #{pageInfo.pageSize}) AS PAGE_NO,
                    #{pageInfo.pageSize} AS PAGE_SIZE,
                    CEIL(COUNT(*) OVER()) AS TOTAL_COUNT,
                    AA.*
            FROM (
    </sql>

    <sql id="pagingPostSQL">
            ) AA
        ) AA
        <where>
            <if test="pageInfo.pageNo != null and pageInfo.pageNo != ''">
                PAGE_NO = #{pageInfo.pageNo}
            </if>
        </where>
    </sql>

</mapper>
